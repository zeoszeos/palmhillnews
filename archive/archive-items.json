      {"date": "2026-10-04", "id": "2026-10-04-calendar-new-look", "title": "Palm Hill Calendar Has a New Look", "text": "The club says its new calendar now reflects the booking system. After signing in, residents can use Upcoming, Month, or Week views, search activities, and tap an item for its time, room, and contact details.", "source": "Communications Committee announcement, September 30", "issues": ["2026-10-04"]},
      {"date": "2026-10-04", "id": "2026-10-04-largo-library-outreach", "title": "Largo Library Outreach: Home Delivery", "text": "Residents who cannot get to the library may be eligible for delivery and pickup of library books. For details, call the Largo Public Library Outreach Liaison at 727-587-6715, extension 2560.", "source": "Palm Hill Webmaster notice, October 1", "issues": ["2026-10-04"]},
      {"date": "2026-10-04", "id": "2026-10-04-october-mowing", "title": "October Mowing Dates", "text": "BrightView reported tentative resident mowing dates of Tuesday, October 13 and Tuesday, October 27. The schedule may change.", "source": "Resource Property Management message relaying BrightView, September 29", "issues": ["2026-10-04"]},
      {"date": "2026-09-27", "id": "2026-09-27-block-captain-nov-dec", "title": "Block Captain Needed for November & December", "text": "A volunteer is needed to deliver LINK booklets on Palm Forest 13–16, 41–49, 51 and 67–68. Call or text Cindy Peitz at 314-359-1953 or email CSP194@yahoo.com.", "source": "Palm Hill Webmaster notice, September 25", "issues": ["2026-09-27", "2026-10-04"]},
      {"date": "2026-09-27", "id": "2026-09-27-early-election-volunteers", "title": "Early Election Volunteers Needed", "text": "Paid volunteers are needed for six-hour early-election shifts ahead of the November 3 election. Call 727-464-6110 for information.", "source": "Palm Hill Webmaster notice, September 25", "issues": ["2026-09-27", "2026-10-04"]},
      {"date": "2026-09-27", "id": "2026-09-27-lost-cat", "title": "Lost Cat", "text": "A gray cat wearing a blue collar and bell was seen between 63 and 65 Pindo Palm W. If you have lost a cat, please check that area.", "source": "Palm Hill Webmaster email", "issues": ["2026-09-27"]},
